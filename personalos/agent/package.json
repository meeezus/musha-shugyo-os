{
  "name": "personalos-agent",
  "version": "1.0.0",
  "description": "PersonalOS Local Agent System - AI-powered automation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "test": "ts-node src/index.ts --test",
    "test:overview": "ts-node src/jobs/morning-overview.ts",
    "test:email-scanner": "ts-node src/jobs/email-scanner.ts",
    "test:relationship": "ts-node src/jobs/relationship-refresh.ts",
    "test:calendar": "ts-node src/mcp/calendar.ts",
    "test:discord": "ts-node src/discord/bot.ts",
    "test:oura": "ts-node src/mcp/oura.ts",
    "sync:oura": "ts-node src/jobs/oura-sync.ts",
    "msos:status": "ts-node src/jobs/msos-monitor.ts --status",
    "msos:monitor": "ts-node src/jobs/msos-monitor.ts --daemon",
    "msos:restart": "ts-node src/jobs/msos-monitor.ts --restart",
    "oauth": "ts-node scripts/generate-oauth-token.ts",
    "build": "tsc",
    "start": "node dist/index.js"
