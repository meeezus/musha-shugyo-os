    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.2",
    "bree": "^9.2.6",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^169.0.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  }
