#!/bin/bash
# Recovery Routine CLI - Quick terminal commands for tracking Sean's exercises
# Usage: recovery [command] [args]
#
# Commands:
#   status          Show today's recovery status
#   scaps [count]   Add scapular squeezes (default: 20)
#   done            Mark entire routine complete
#   log [item]      Toggle a specific item
#
# Examples:
#   recovery status
#   recovery scaps 30
#   recovery done
#   recovery log chin_darts

# Configuration
API_BASE="http://localhost:8000/api"
# Get auth token from .env or use default
TOKEN="${PERSONALOS_API_TOKEN:-}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Helper to make authenticated API calls
api_call() {
    local method=$1
    local endpoint=$2
    local data=$3

    if [ -n "$TOKEN" ]; then
        if [ "$method" = "GET" ]; then
            curl -s -X GET "${API_BASE}${endpoint}" \
                -H "Authorization: Bearer ${TOKEN}" \
                -H "Accept: application/json"
        else
            curl -s -X POST "${API_BASE}${endpoint}" \
                -H "Authorization: Bearer ${TOKEN}" \
                -H "Accept: application/json" \
                -H "Content-Type: application/json" \
                -d "$data"
        fi
    else
        # Try without auth (for local dev with session)
        if [ "$method" = "GET" ]; then
            curl -s -X GET "${API_BASE}${endpoint}" \
                -H "Accept: application/json" \
                -b ~/.personalos_cookies
        else
            curl -s -X POST "${API_BASE}${endpoint}" \
                -H "Accept: application/json" \
                -H "Content-Type: application/json" \
                -b ~/.personalos_cookies \
                -d "$data"
        fi
    fi
}

# Show status
show_status() {
    local response=$(api_call GET "/recovery/status")

    if [ -z "$response" ] || [[ "$response" == *"error"* ]]; then
        echo -e "${RED}Failed to fetch recovery status. Is the server running?${NC}"
        echo "Try: cd ~/PersonalOS/personalos && php artisan serve"
        exit 1
    fi

    # Parse JSON response (requires jq)
    if ! command -v jq &> /dev/null; then
        echo "$response"
        return
    fi

    local date=$(echo "$response" | jq -r '.date')
    local completed=$(echo "$response" | jq -r '.completion.completed')
    local total=$(echo "$response" | jq -r '.completion.total')
    local percentage=$(echo "$response" | jq -r '.completion.percentage')
    local is_complete=$(echo "$response" | jq -r '.completion.is_complete')
    local scaps=$(echo "$response" | jq -r '.items.scapular_squeezes')
    local streak=$(echo "$response" | jq -r '.weekly.streak')
    local days_done=$(echo "$response" | jq -r '.weekly.days_completed')

    echo ""
    echo -e "${BOLD}RECOVERY ROUTINE - ${date}${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if [ "$is_complete" = "true" ]; then
        echo -e "${GREEN}✓ COMPLETE${NC} (${completed}/${total})"
    else
        echo -e "${YELLOW}○ IN PROGRESS${NC} (${completed}/${total}) - ${percentage}%"
    fi

    if [ "$streak" -gt 0 ]; then
        echo -e "🔥 Streak: ${streak} days"
    fi

    echo ""
    echo "Items:"

    # Left Brain
    local lb_am=$(echo "$response" | jq -r '.items.left_brain_am')
    local lb_pm=$(echo "$response" | jq -r '.items.left_brain_pm')
    [ "$lb_am" = "true" ] && echo -e "  ${GREEN}✓${NC} Left Brain AM" || echo -e "  ${RED}○${NC} Left Brain AM"
    [ "$lb_pm" = "true" ] && echo -e "  ${GREEN}✓${NC} Left Brain PM" || echo -e "  ${RED}○${NC} Left Brain PM"

    # Scaps
    if [ "$scaps" -ge 80 ]; then
        echo -e "  ${GREEN}✓${NC} Scapular Squeezes: ${scaps}/100"
    else
        echo -e "  ${YELLOW}○${NC} Scapular Squeezes: ${scaps}/100"
    fi

    # Other items
    for item in rear_deltoid bicep_tricep_reset tricep_extension chin_darts pec_lat_massage; do
        local value=$(echo "$response" | jq -r ".items.${item}")
        local label=$(echo "$item" | sed 's/_/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
        [ "$value" = "true" ] && echo -e "  ${GREEN}✓${NC} ${label}" || echo -e "  ${RED}○${NC} ${label}"
    done

    echo ""
    echo -e "Week: ${days_done} days completed"
    echo ""
}

# Add scaps
add_scaps() {
    local count=${1:-20}
    local response=$(api_call POST "/recovery/scaps" "{\"count\": $count}")

    if ! command -v jq &> /dev/null; then
        echo "$response"
        return
    fi

    local new_total=$(echo "$response" | jq -r '.scapular_squeezes')
    local remaining=$(echo "$response" | jq -r '.remaining')
    local is_done=$(echo "$response" | jq -r '.is_done')

    if [ "$is_done" = "true" ]; then
        echo -e "${GREEN}✓${NC} Scapular squeezes: ${new_total}/100 - ${GREEN}DONE!${NC}"
    else
        echo -e "${YELLOW}+${count}${NC} Scapular squeezes: ${new_total}/100 (${remaining} to go)"
    fi
}

# Mark day complete
mark_complete() {
    local response=$(api_call POST "/recovery/complete-day" "{}")

    if ! command -v jq &> /dev/null; then
        echo "$response"
        return
    fi

    local success=$(echo "$response" | jq -r '.success')
    if [ "$success" = "true" ]; then
        echo -e "${GREEN}✓ Recovery routine marked complete for today!${NC}"
    else
        echo -e "${RED}Failed to mark complete${NC}"
    fi
}

# Log specific item
log_item() {
    local item=$1
    if [ -z "$item" ]; then
        echo "Usage: recovery log [item]"
        echo "Items: left_brain_am, left_brain_pm, rear_deltoid, bicep_tricep_reset, tricep_extension, chin_darts, pec_lat_massage"
        exit 1
    fi

    local response=$(api_call POST "/recovery/log" "{\"item\": \"$item\", \"value\": true}")

    if ! command -v jq &> /dev/null; then
        echo "$response"
        return
    fi

    local success=$(echo "$response" | jq -r '.success')
    local new_value=$(echo "$response" | jq -r '.new_value')

    if [ "$success" = "true" ]; then
        local label=$(echo "$item" | sed 's/_/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
        if [ "$new_value" = "true" ]; then
            echo -e "${GREEN}✓${NC} ${label} marked complete"
        else
            echo -e "${YELLOW}○${NC} ${label} unmarked"
        fi
    else
        echo -e "${RED}Failed to update ${item}${NC}"
    fi
}

# Main command handler
case "${1:-status}" in
    status|s)
        show_status
        ;;
    scaps|sq)
        add_scaps "${2:-20}"
        ;;
    done|complete|d)
        mark_complete
        ;;
    log|l)
        log_item "$2"
        ;;
    help|h|--help|-h)
        echo "Recovery Routine CLI"
        echo ""
        echo "Usage: recovery [command] [args]"
        echo ""
        echo "Commands:"
        echo "  status, s          Show today's status"
        echo "  scaps [n], sq      Add scapular squeezes (default: 20)"
        echo "  done, d            Mark entire routine complete"
        echo "  log [item], l      Toggle a specific item"
        echo ""
        echo "Items:"
        echo "  left_brain_am, left_brain_pm, rear_deltoid,"
        echo "  bicep_tricep_reset, tricep_extension, chin_darts, pec_lat_massage"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'recovery help' for usage"
        exit 1
        ;;
esac
